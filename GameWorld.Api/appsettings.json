{
  "Database": { "Provider": "SqlServer", "Initialize": true },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/gameworld.db",
    "SqlServer": "Server=(localdb)\\mssqllocaldb;Database=GameWorld;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "GameWorldApi",
    "Audience": "GameWorldClient",
    "ExpiryMinutes": 60
  },
  "BootstrapAdmin": { "Username": "admin", "Password": "" },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
